# Neon PostgreSQL connection string. Never commit the real value.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000

# Public LinkUp web origin. Use the exact HTTPS origin in production.
LINKUP_WEB_ORIGIN=https://your-linkup-web.example.com

# Contact/report email delivery. Keep the Resend key server-side only.
RESEND_API_KEY=
LINKUP_EMAIL_FROM=LinkUp <no-reply@your-verified-domain.example>
CONTACT_ADMIN_EMAIL=seravellenyravalen@gmail.com

# Runtime
HOST=0.0.0.0
PORT=3000
